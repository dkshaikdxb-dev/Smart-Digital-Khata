# =========================================================================
# Smart Digital Khata — Environment Variables
# =========================================================================
# Copy this file to .env and fill in every value marked with <CHANGE_ME>.
# Never commit .env to git.
# =========================================================================

# ---- App ------------------------------------------------------------------
NODE_ENV=production
APP_NAME=SmartDigitalKhata
APP_URL=http://localhost:4000
ADMIN_URL=http://localhost:3000
TZ=Asia/Kolkata

# ---- Backend --------------------------------------------------------------
LOG_LEVEL=info

# ---- Host port mapping (isolation from other projects) --------------------
# Change these ONLY if another project on the same machine already uses them.
# All are localhost-bound except HTTP/HTTPS (the public nginx entry points).
HTTP_PORT=80
HTTPS_PORT=443
BACKEND_HOST_PORT=4000
ADMIN_HOST_PORT=3000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# ---- Security -------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=<CHANGE_ME_random_32_char_hex>
JWT_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=10

# ---- Database (Postgres) --------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=skhata
POSTGRES_USER=skhata
POSTGRES_PASSWORD=<CHANGE_ME_strong_password>
DATABASE_URL=postgres://skhata:<CHANGE_ME_strong_password>@postgres:5432/skhata

# ---- Redis ----------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ---- Integrations: .env is the FALLBACK ------------------------------------
# Every integration below (Razorpay, WhatsApp, AI, Meta, SMTP, Bhashini/Sarvam)
# can now be set from Admin -> Settings (stored in platform_settings). A value
# saved in the panel OVERRIDES the .env value; leave a .env value blank (or
# unset) to manage it from the panel only. Changing any of them in the panel
# requires typing "I CONFIRM". Secrets are never shown back in the panel.

# ---- Razorpay -------------------------------------------------------------
# https://dashboard.razorpay.com/app/keys  (or Admin -> Settings -> Razorpay)
RAZORPAY_KEY_ID=<CHANGE_ME>
RAZORPAY_KEY_SECRET=<CHANGE_ME>
RAZORPAY_WEBHOOK_SECRET=<CHANGE_ME>
# Recurring billing: create plans in Razorpay dashboard → Subscriptions →
# Plans, then paste the plan IDs (plan_XXXX). Leave blank to use manual
# plan switching (dev/demo mode).
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_FAMILY=

# ---- WhatsApp Cloud API ---------------------------------------------------
# https://developers.facebook.com/docs/whatsapp/cloud-api
# (or Admin -> Settings -> WhatsApp Cloud API)
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_API_TOKEN=<CHANGE_ME>
WHATSAPP_PHONE_NUMBER_ID=<CHANGE_ME>
WHATSAPP_VERIFY_TOKEN=<CHANGE_ME_any_string_you_choose>
WHATSAPP_BUSINESS_ACCOUNT_ID=<CHANGE_ME>
# Meta-approved template for dues reminders (required for delivery outside
# the 24h session window). See docs/WHATSAPP_TEMPLATES.md. Blank = plain text.
WHATSAPP_TEMPLATE_REMINDER=
WHATSAPP_TEMPLATE_LANG=en

# ---- AI: moderation triage + content drafts -------------------------------
# Optional. Can be set from Admin -> Settings -> Integrations -> AI. Both the
# key and a model id are needed; the model id is whatever your provider
# publishes — nothing is hardcoded. Blank = feature inert.
ANTHROPIC_API_KEY=
MODERATION_LLM_MODEL=
CONTENT_LLM_MODEL=
# Tuning knobs (env only — not in the panel):
# MODERATION_LLM_MAX_TOKENS=300  MODERATION_LLM_TIMEOUT_MS=20000  CONTENT_LLM_MAX_TOKENS=4000

# ---- Meta app: Facebook / Instagram publishing ----------------------------
# Optional. Can be set from Admin -> Settings -> Integrations -> Meta. Needs a
# Meta app that has passed App Review; auto-post stays locked until then.
META_APP_ID=
META_APP_SECRET=
META_PAGE_TOKEN=
META_IG_TOKEN=

# ---- SMTP: newsletters ----------------------------------------------------
# Optional. Can be set from Admin -> Settings -> Integrations -> Email. Either
# SMTP_URL (smtps://user:pass@host:465) OR SMTP_HOST + SMTP_PORT (+ user/pass),
# plus NEWSLETTER_FROM. Blank = newsletters fall back to the outbox.
SMTP_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
NEWSLETTER_FROM=

# ---- Speech & translation: Bhashini / Sarvam ------------------------------
# Optional. Can be set from Admin -> Settings -> Integrations -> Speech &
# translation. BHASHINI_NMT=1 turns on the neural-translation seam (no-op until
# a provider adapter is wired); the keys are stored for that adapter.
BHASHINI_NMT=
BHASHINI_API_KEY=
BHASHINI_USER_ID=
SARVAM_API_KEY=

# ---- Admin seed user ------------------------------------------------------
# Created on first migration
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<CHANGE_ME_admin_password>

# ---- Rate limiting --------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Consumer auth (customer-auth) per-IP limiter. Defaults are deliberately
# generous because many legitimate users on shared / NAT'd village connections
# sit behind ONE public IP; a tight per-IP cap would throttle the whole group.
# This is safe: the real brute-force defense is per-account (OTP is single-use
# with an attempt cap; PIN login locks the account after 5 wrong tries).
AUTH_RATE_WINDOW_MS=60000
AUTH_RATE_MAX=20

# ---- Demo OTP (testing/demo only) -----------------------------------------
# Comma-separated E164 phone numbers (e.g. +919812345678,+919800000000). Any
# number listed here has its login OTP returned in the API response (dev_code)
# EVEN in production, so the operator can demo/test consumer login without a
# real SMS. It NEVER affects numbers that are not listed and does not change OTP
# verification. Leave EMPTY in real production.
DEMO_OTP_PHONES=

# ---- CORS -----------------------------------------------------------------
# Comma-separated list of allowed origins. Leave blank to allow all (dev only).
# Example: https://khata.example.com,https://admin.khata.example.com
ALLOWED_ORIGINS=

# ---- Admin dashboard (Next.js public vars) --------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public marketing landing (site root "/") WhatsApp CTA. Optional. Set to the
# WhatsApp number in international format WITHOUT the leading "+" or spaces
# (e.g. 919812345678); the landing's "WhatsApp पर शुरू करें" button then links
# to https://wa.me/<number>. Leave EMPTY and the button falls back to /register.
NEXT_PUBLIC_WHATSAPP=
