# =========================================================================
# Smart Digital Khata — Environment Variables
# =========================================================================
# Copy this file to .env and fill in every value marked with <CHANGE_ME>.
# Never commit .env to git.
# =========================================================================

# ---- App ------------------------------------------------------------------
NODE_ENV=production
APP_NAME=SmartDigitalKhata
APP_URL=http://localhost:4000
ADMIN_URL=http://localhost:3000
TZ=Asia/Kolkata

# ---- Backend --------------------------------------------------------------
BACKEND_PORT=4000
LOG_LEVEL=info

# ---- Security -------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=<CHANGE_ME_random_32_char_hex>
JWT_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=10

# ---- Database (Postgres) --------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=skhata
POSTGRES_USER=skhata
POSTGRES_PASSWORD=<CHANGE_ME_strong_password>
DATABASE_URL=postgres://skhata:<CHANGE_ME_strong_password>@postgres:5432/skhata

# ---- Redis ----------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ---- Razorpay -------------------------------------------------------------
# https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=<CHANGE_ME>
RAZORPAY_KEY_SECRET=<CHANGE_ME>
RAZORPAY_WEBHOOK_SECRET=<CHANGE_ME>

# ---- WhatsApp Cloud API ---------------------------------------------------
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_API_TOKEN=<CHANGE_ME>
WHATSAPP_PHONE_NUMBER_ID=<CHANGE_ME>
WHATSAPP_VERIFY_TOKEN=<CHANGE_ME_any_string_you_choose>
WHATSAPP_BUSINESS_ACCOUNT_ID=<CHANGE_ME>

# ---- Admin seed user ------------------------------------------------------
# Created on first migration
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<CHANGE_ME_admin_password>

# ---- Rate limiting --------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ---- CORS -----------------------------------------------------------------
# Comma-separated list of allowed origins. Leave blank to allow all (dev only).
# Example: https://khata.example.com,https://admin.khata.example.com
ALLOWED_ORIGINS=

# ---- Admin dashboard (Next.js public vars) --------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
